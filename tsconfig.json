{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM"],
    "allowJs": true,  // IMPORTANTE: Permitir archivos .js
    "checkJs": true,  // Opcional: Verificar tipos en archivos .js
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": false,  // Empieza con false para transición suave
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.js",  // Incluir archivos JavaScript
    "src/**/*.tsx",
    "src/**/*.jsx"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}